// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client { //onde o typescript será gerado (src/generated/prisma) e qual provider será usado (prisma-client)
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db { //Qual banco postgreSql a URL fica no prisma.config.ts
  provider = "postgresql"
}

model User { 
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("users")
}

model Product { //uma tabela. Cada linha é uma coluna: nome, tipo, atributos
  id        Int      @id @default(autoincrement())//chave primaria cresce sozinha
  name      String
  price     Decimal  @db.Decimal(10, 2)
  image     String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("products") //nome da coluna\ tabela no banco (snake_case); no código camel case
}

